{
  "name": "population-trends",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Psychohistory Atlas — interactive population pyramids, world map, and triangle demography explorer",
  "scripts": {
    "dev": "vite",
    "build": "node ./node_modules/typescript/lib/tsc.js --noEmit && vite build",
    "preview": "vite preview",
    "data:ingest": "node scripts/ingest-all.mjs",
    "data:wpp": "python scripts/ingest-wpp.py",
    "data:check": "node scripts/validate-data.mjs",
    "start": "vite"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^4.5.14"
  }
}
